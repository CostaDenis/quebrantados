@page "/landing"
@layout LandingLayout

<PageTitle>Quebrantados — Reflexões à luz da Palavra</PageTitle>

<div class="min-h-screen bg-background text-main-text antialiased">

    <MainMenu />

    <main id="inicio">
        <section class="relative isolate overflow-hidden border-b border-border/70">
            <div
                class="absolute inset-0 -z-10 opacity-50 bg-[radial-gradient(circle_at_20%_10%,#D4B36A22,transparent_32%),radial-gradient(circle_at_80%_70%,#74533D18,transparent_30%)]">
            </div>

            <div
                class="mx-auto grid max-w-7xl items-center gap-14 px-5 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-28">
                <div class="max-w-3xl">
                    <div
                        class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary-golden">
                        <span class="h-px w-10 bg-primary-golden"></span>
                        Palavra que transforma
                    </div>

                    <h1
                        class="font-serif text-5xl leading-[1.08] font-semibold tracking-tight text-primary-brown sm:text-6xl lg:text-7xl">
                        Onde a alma encontra<br />
                        <em class="font-normal text-primary-golden">descanso e direção.</em>
                    </h1>

                    <p class="mt-7 max-w-2xl text-lg leading-8 text-muted-text">
                        Reflexões bíblicas para quem deseja conhecer as Escrituras com profundidade, cultivar a fé e
                        viver o Evangelho no cotidiano.
                    </p>

                    <div class="mt-9 flex flex-wrap gap-4">
                        <a href="#reflexoes"
                           class="rounded-full bg-primary-brown px-7 py-3.5 font-semibold text-surface shadow-lg shadow-primary-brown/10 transition hover:-translate-y-0.5 hover:bg-secondary-brown">
                            Explorar reflexões
                        </a>
                        <a href="#sobre"
                           class="rounded-full border border-border bg-surface px-7 py-3.5 font-semibold text-primary-brown transition hover:border-primary-golden">
                            Conheça o projeto
                        </a>
                    </div>
                </div>

                <aside class="relative mx-auto w-full max-w-md">
                    <div
                        class="absolute -inset-5 -z-10 rotate-3 rounded-4xl border border-primary-golden/25 bg-background-alternative">
                    </div>
                    <blockquote
                        class="rounded-4xl border border-border bg-surface p-9 shadow-xl shadow-primary-brown/8 sm:p-11">
                        <svg class="mb-7 size-9 text-primary-golden" viewBox="0 0 24 24" fill="currentColor"
                             aria-hidden="true">
                            <path d="M7.2 17H3l3-10h5l-3.8 10Zm10 0H13l3-10h5l-3.8 10Z" />
                        </svg>
                        <p class="font-serif text-2xl leading-relaxed text-primary-brown">
                            “Perto está o Senhor dos que têm o coração quebrantado.”
                        </p>
                        <footer
                            class="mt-6 flex items-center gap-4 text-sm font-bold uppercase tracking-[0.18em] text-primary-golden">
                            <span class="h-px w-8 bg-primary-golden"></span>
                            Salmos 34:18
                        </footer>
                    </blockquote>
                </aside>
            </div>
        </section>

        <section id="reflexoes" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
            <div class="mb-11 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
                <div>
                    <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary-golden">Leitura em
                        destaque</p>
                        <h2 class="font-serif text-4xl font-semibold text-primary-brown">Reflexões para esta semana</h2>
                    </div>
                    <a href="#"
                       class="font-semibold text-primary-brown underline decoration-primary-golden decoration-2 underline-offset-8">Ver
                        todos os posts</a>
                    </div>

                    <div class="grid gap-6 lg:grid-cols-3">
                        @foreach (var post in FeaturedPosts)
                        {
                            <article
                                class="group flex min-h-80 flex-col rounded-3xl border border-border bg-surface p-7 transition hover:-translate-y-1 hover:border-primary-golden/60 hover:shadow-xl hover:shadow-primary-brown/8">
                                <div class="mb-8 flex items-center justify-between">
                                    <span
                                    class="rounded-full bg-background-alternative px-3 py-1 text-xs font-bold uppercase tracking-wider text-secondary-brown">@post.Category</span>
                                    <span class="text-sm text-muted-text">@post.ReadTime</span>
                                </div>
                                <h3
                                    class="font-serif text-2xl leading-snug font-semibold text-primary-brown transition group-hover:text-secondary-brown">
                                    @post.Title</h3>
                                    <p class="mt-4 flex-1 leading-7 text-muted-text">@post.Summary</p>
                                    <a href="#" class="mt-7 inline-flex items-center gap-2 font-semibold text-primary-golden">
                                        Continuar lendo <span aria-hidden="true">→</span>
                                    </a>
                                </article>
                            }
                        </div>
                    </section>

                    <section id="categorias" class="bg-primary-brown text-surface">
                        <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:px-8 lg:py-24">
                            <div>
                                <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-secondary-golden">Caminhos de
                                    estudo</p>
                                    <h2 class="font-serif text-4xl leading-tight font-semibold">Encontre uma palavra para o seu momento.
                                    </h2>
                                    <p class="mt-5 max-w-md leading-7 text-background-alternative/75">Navegue por temas que conectam as
                                        Escrituras aos desafios, perguntas e alegrias da vida cristã.</p>
                                    </div>

                                    <div class="grid gap-3 sm:grid-cols-2">
                                        @foreach (var category in Categories)
                                        {
                                            <a href="#"
                                               class="flex items-center justify-between rounded-2xl border border-surface/15 bg-surface/5 px-5 py-4 font-medium text-surface transition hover:border-secondary-golden/60 hover:bg-surface/10">
                                                @category <span class="text-secondary-golden" aria-hidden="true">↗</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </section>

                            <section id="sobre" class="mx-auto max-w-4xl px-5 py-20 text-center lg:py-24">
                                <div
                                    class="mx-auto mb-6 grid size-16 place-items-center rounded-full bg-background-alternative text-primary-golden">
                                    <img src="imgs/idea.svg" class="h-10 w-10">
                                </div>
                                <h2 class="font-serif text-4xl font-semibold text-primary-brown">Um espaço para ler, meditar e crescer.</h2>
                                <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted-text">
                                    O Quebrantados nasceu para tornar o estudo bíblico acolhedor e profundo, colocando a Palavra no centro
                                    de conversas sinceras sobre fé e vida.
                                </p>
                            </section>
                        </main>

                        <Footer />
                    </div>

@code {
    private static readonly LandingPost[] FeaturedPosts =
    [
        new("Vida cristã", "Quando Deus parece estar em silêncio", "Uma reflexão sobre espera, confiança e a presença de Deus nos períodos em que as respostas não chegam.", "6 min"),
        new("Estudo bíblico", "O que significa ter um coração quebrantado?", "Um olhar para os Salmos e para o convite bíblico a uma vida sincera diante do Senhor.", "8 min"),
        new("Evangelho", "Graça para recomeçar todos os dias", "Como a graça de Cristo transforma culpa em arrependimento, esperança e um novo caminho.", "5 min")
    ];

    private static readonly string[] Categories =
    [
        "Estudos bíblicos",
        "Vida cristã",
        "Antigo Testamento",
        "Novo Testamento",
        "Devocionais",
        "Teologia"
    ];

    private sealed record LandingPost(string Category, string Title, string Summary, string ReadTime);
}
