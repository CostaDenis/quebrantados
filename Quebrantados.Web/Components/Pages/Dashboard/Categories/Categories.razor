@page "/dashboard/categorias"
@layout MainLayout

<PageTitle>Categorias — Quebrantados</PageTitle>

<div class="mx-auto max-w-360">
    <HeaderDashboard PageName="Organização do conteúdo" PageTitle="Categorias"
                     PageDescription="Gerencie os grandes temas que organizam as reflexões publicadas.">
        <LinkDashboard Href="/dashboard/categorias/adicionar">
            <SpanDashboard Value="+" />
            Nova categoria
        </LinkDashboard>
    </HeaderDashboard>

    <section class="grid gap-4 py-8 sm:grid-cols-3" aria-label="Resumo das categorias">
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Total de categorias</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@CategoryItems.Count</p>
            <p class="mt-3 text-xs text-muted-text">Grandes áreas editoriais do blog</p>
        </article>
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Com reflexões</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@CategoryItems.Count(category =>
                                                                                category.PostCount > 0)</p>
                <p class="mt-3 text-xs text-muted-text">Categorias atualmente em uso</p>
            </article>
            <article class="rounded-3xl border border-primary-golden/25 bg-background-alternative p-5">
                <p class="text-sm font-medium text-muted-text">Sem conteúdo</p>
                <p class="mt-2 font-serif text-4xl font-semibold text-primary-golden">@CategoryItems.Count(category =>
                                                                                                category.PostCount == 0)</p>
                    <p class="mt-3 text-xs text-muted-text">Podem ser revisadas ou removidas</p>
                </article>
            </section>

            <section class="overflow-hidden rounded-3xl border border-border bg-surface">
                <div class="flex flex-col justify-between gap-4 border-b border-border p-5 sm:flex-row sm:items-center sm:px-6">
                    <div>
                        <h2 class="font-serif text-2xl font-semibold text-primary-brown">Todas as categorias</h2>
                        <p class="mt-1 text-sm text-muted-text">Visualize e gerencie a organização editorial do blog.</p>
                    </div>
                    <label class="relative block w-full sm:max-w-xs">
                        <span class="sr-only">Buscar categoria</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             class="absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted-text" aria-hidden="true">
                            <circle cx="11" cy="11" r="6" />
                            <path d="m16 16 4 4" />
                        </svg>
                        <input type="search" placeholder="Buscar categoria..."
                               class="w-full rounded-2xl border border-border bg-background py-2.5 pr-4 pl-10 text-sm text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15" />
                    </label>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-184 border-collapse text-left">
                        <thead
                            class="bg-background-alternative/65 text-xs font-bold uppercase tracking-[0.14em] text-muted-text">
                            <tr>
                                <th class="px-6 py-4">Categoria</th>
                                <th class="px-6 py-4">Slug</th>
                                <th class="px-6 py-4 text-center">Reflexões</th>
                                <th class="px-6 py-4">Situação</th>
                                <th class="px-6 py-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @foreach (var category in CategoryItems)
                            {
                                <tr class="transition hover:bg-background/70">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <span
                                            class="grid size-10 shrink-0 place-items-center rounded-xl bg-background-alternative font-serif font-semibold text-primary-golden">@category.Name[..1]</span>
                                            <div>
                                                <strong class="block font-semibold text-primary-brown">@category.Name</strong>
                                                <small class="mt-0.5 block text-xs text-muted-text">Atualizada
                                                    @category.LastUpdate</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5 font-mono text-sm text-muted-text">/categorias/@category.Slug</td>
                                        <td class="px-6 py-5 text-center font-semibold text-primary-brown">@category.PostCount</td>
                                        <td class="px-6 py-5">
                                            @if (category.PostCount > 0)
                                            {
                                                <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">Em
                                                    uso</span>
                                                }
                                else
                                                {
                                                    <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Sem
                                                        conteúdo</span>
                                                    }
                                                </td>
                                                <td class="px-6 py-5">
                                                    <div class="flex justify-end gap-2">
                                                        <a href="@($"/categorias/{category.Slug}")" aria-label="Visualizar @category.Name"
                                                           class="rounded-xl border border-border px-3 py-2 text-xs font-semibold text-muted-text transition hover:border-primary-golden hover:text-primary-brown">Ver</a>
                                                        <a href="@($"/dashboard/categorias/editar")" aria-label="Editar @category.Name"
                                                           class="rounded-xl bg-background-alternative px-3 py-2 text-xs font-semibold text-secondary-brown transition hover:bg-border">Editar</a>
                                                        <button type="button" aria-label="Excluir @category.Name"
                                                                class="rounded-xl border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50">Excluir</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <footer
                                class="flex flex-col justify-between gap-3 border-t border-border px-5 py-4 text-sm text-muted-text sm:flex-row sm:items-center sm:px-6">
                                <span>Exibindo @CategoryItems.Count categorias</span>
                                <span>Ordenadas por nome</span>
                            </footer>
                        </section>

                        <aside
                            class="mt-6 flex gap-4 rounded-3xl border border-primary-golden/25 bg-background-alternative p-5 sm:items-center">
                            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-golden/15 text-primary-golden"
                                  aria-hidden="true">!</span>
                            <p class="text-sm leading-6 text-muted-text"><strong class="text-primary-brown">Atenção ao excluir:</strong>
                                categorias associadas a reflexões não poderão ser removidas até que o conteúdo seja transferido para outro
                                tema.</p>
                            </aside>
                        </div>

@code {
    private static readonly List<CategoryPreview> CategoryItems =
    [
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6101"), "Antigo Testamento", "antigo-testamento", 8, "há 2 dias"),
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6102"), "Devocionais", "devocionais", 4, "ontem"),
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6103"), "Estudos bíblicos", "estudos-biblicos", 5, "há 3 dias"),
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6104"), "Novo Testamento", "novo-testamento", 6, "há 1 semana"),
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6105"), "Teologia", "teologia", 0, "há 5 dias"),
        new(Guid.Parse("a10c17f8-8d87-49cd-88d4-9c00ab4a6106"), "Vida cristã", "vida-crista", 9, "hoje")
    ];

    private sealed record CategoryPreview(Guid Id, string Name, string Slug, int PostCount, string LastUpdate);
}
