@page "/dashboard/tags"
@layout MainLayout

<PageTitle>
    Tags — Quebrantados
</PageTitle>

<div class="mx-auto max-w-360">
    <HeaderDashboard PageName="Organização do conteúdo" PageTitle="Tags"
                     PageDescription="Gerencie os assuntos específicos que conectam e facilitam a descoberta das reflexões.">
        <LinkDashboard Href="/dashboard/tags/adicionar">
            <SpanDashboard Value="+" />
            Nova tag
        </LinkDashboard>
    </HeaderDashboard>

    <section class="grid gap-4 py-8 sm:grid-cols-3" aria-label="Resumo das tags">
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Total de tags</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@TagItems.Count</p>
            <p class="mt-3 text-xs text-muted-text">Assuntos disponíveis no blog</p>
        </article>
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Em uso</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@TagItems.Count(tag => tag.PostCount >
                                                0)</p>
                <p class="mt-3 text-xs text-muted-text">Tags associadas a reflexões</p>
            </article>
            <article class="rounded-3xl border border-primary-golden/25 bg-background-alternative p-5">
                <p class="text-sm font-medium text-muted-text">Sem conteúdo</p>
                <p class="mt-2 font-serif text-4xl font-semibold text-primary-golden">@TagItems.Count(tag => tag.PostCount
                                                        == 0)</p>
                    <p class="mt-3 text-xs text-muted-text">Podem ser revisadas ou removidas</p>
                </article>
            </section>

            <section class="overflow-hidden rounded-3xl border border-border bg-surface">
                <div class="flex flex-col justify-between gap-4 border-b border-border p-5 sm:flex-row sm:items-center sm:px-6">
                    <div>
                        <h2 class="font-serif text-2xl font-semibold text-primary-brown">Todas as tags</h2>
                        <p class="mt-1 text-sm text-muted-text">Visualize e gerencie os assuntos usados nas reflexões.</p>
                    </div>
                    <label class="relative block w-full sm:max-w-xs">
                        <span class="sr-only">Buscar tag</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             class="absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted-text" aria-hidden="true">
                            <circle cx="11" cy="11" r="6" />
                            <path d="m16 16 4 4" />
                        </svg>
                        <input type="search" placeholder="Buscar tag..."
                               class="w-full rounded-2xl border border-border bg-background py-2.5 pr-4 pl-10 text-sm text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15" />
                    </label>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-184 border-collapse text-left">
                        <thead
                            class="bg-background-alternative/65 text-xs font-bold uppercase tracking-[0.14em] text-muted-text">
                            <tr>
                                <th class="px-6 py-4">Tag</th>
                                <th class="px-6 py-4">Slug</th>
                                <th class="px-6 py-4 text-center">Reflexões</th>
                                <th class="px-6 py-4">Situação</th>
                                <th class="px-6 py-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @foreach (var tag in TagItems)
                            {
                                <tr class="transition hover:bg-background/70">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <span
                                            class="grid size-10 shrink-0 place-items-center rounded-xl bg-background-alternative font-serif text-lg font-semibold text-primary-golden">#</span>
                                            <div>
                                                <strong class="block font-semibold text-primary-brown">@tag.Name</strong>
                                                <small class="mt-0.5 block text-xs text-muted-text">Atualizada
                                                    @tag.LastUpdate</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5 font-mono text-sm text-muted-text">/tags/@tag.Slug</td>
                                        <td class="px-6 py-5 text-center font-semibold text-primary-brown">@tag.PostCount</td>
                                        <td class="px-6 py-5">
                                            @if (tag.PostCount > 0)
                                            {
                                                <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">Em
                                                    uso</span>
                                                }
                                else
                                                {
                                                    <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Sem
                                                        conteúdo</span>
                                                    }
                                                </td>
                                                <td class="px-6 py-5">
                                                    <div class="flex justify-end gap-2">
                                                        <a href="@($"/dashboard/tags/{tag.Id}/editar")" aria-label="Editar @tag.Name"
                                                           class="rounded-xl bg-background-alternative px-3 py-2 text-xs font-semibold text-secondary-brown transition hover:bg-border">Editar</a>
                                                        <button type="button" aria-label="Excluir @tag.Name"
                                                                class="rounded-xl border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50">Excluir</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <footer
                                class="flex flex-col justify-between gap-3 border-t border-border px-5 py-4 text-sm text-muted-text sm:flex-row sm:items-center sm:px-6">
                                <span>Exibindo @TagItems.Count tags</span>
                                <span>Ordenadas por nome</span>
                            </footer>
                        </section>

                        <aside
                            class="mt-6 flex gap-4 rounded-3xl border border-primary-golden/25 bg-background-alternative p-5 sm:items-center">
                            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-golden/15 text-primary-golden"
                                  aria-hidden="true">!</span>
                            <p class="text-sm leading-6 text-muted-text">
                                <strong class="text-primary-brown">Ao excluir uma tag:</strong>
                                as reflexões associadas serão mantidas; somente a ligação com esse assunto será removida.
                            </p>
                        </aside>
                    </div>

@code {
    private static readonly List<TagPreview> TagItems =
    [
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6201"), "Esperança", "esperanca", 7, "hoje"),
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6202"), "Fé", "fe", 12, "ontem"),
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6203"), "Graça", "graca", 8, "há 2 dias"),
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6204"), "Oração", "oracao", 5, "há 4 dias"),
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6205"), "Perdão", "perdao", 3, "há 1 semana"),
        new(Guid.Parse("b20c17f8-8d87-49cd-88d4-9c00ab4a6206"), "Sabedoria", "sabedoria", 0, "há 5 dias")
    ];

    private sealed record TagPreview(Guid Id, string Name, string Slug, int PostCount, string LastUpdate);
}
