@page "/dashboard/tags"
@layout MainLayout
@inherits TagsPage
@rendermode InteractiveServer

<PageTitle>
    Tags — Quebrantados
</PageTitle>

<div class="mx-auto max-w-360">
    <DashboardNotification Message="@NotificationMessage" IsError="@NotificationIsError" />

    <HeaderDashboard PageName="Organização do conteúdo" PageTitle="Tags"
                     PageDescription="Gerencie os assuntos específicos que conectam e facilitam a descoberta das reflexões.">
        <LinkDashboard Href="/dashboard/tags/adicionar">
            <SpanDashboard Value="+" />
            Nova tag
        </LinkDashboard>
    </HeaderDashboard>

    <section class="grid gap-4 py-8 sm:grid-cols-3" aria-label="Resumo das tags">
        @if (TagItems is null)
        {
            @foreach (var _ in Enumerable.Range(0, 3))
            {
                <article class="animate-pulse rounded-3xl border border-border bg-surface p-5" aria-hidden="true">
                    <div class="h-4 w-24 rounded bg-background-alternative"></div>
                    <div class="mt-3 h-10 w-14 rounded bg-background-alternative"></div>
                    <div class="mt-4 h-3 w-40 rounded bg-background-alternative"></div>
                </article>
            }
        }
        else
        {
            <DashboardMetricCard Label="Total de tags" Value="@TagItems.Count" Symbol="#"
                                 Note="Assuntos disponíveis no blog" />
            <DashboardMetricCard Label="Em uso" Value="@TagsInUseCount" Symbol="✓"
                                 Note="Tags associadas a reflexões" />
            <DashboardMetricCard Label="Sem conteúdo" Value="@UnusedTagsCount" Symbol="!"
                                 Note="Podem ser revisadas ou removidas" />
        }
            </section>

            <section class="overflow-hidden rounded-3xl border border-border bg-surface">
                <div class="flex flex-col justify-between gap-4 border-b border-border p-5 sm:flex-row sm:items-center sm:px-6">
                    <div>
                        <h2 class="font-serif text-2xl font-semibold text-primary-brown">Todas as tags</h2>
                        <p class="mt-1 text-sm text-muted-text">Visualize e gerencie os assuntos usados nas reflexões.</p>
                    </div>
                    <label class="relative block w-full sm:max-w-xs">
                        <span class="sr-only">Buscar tag</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             class="absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted-text" aria-hidden="true">
                            <circle cx="11" cy="11" r="6" />
                            <path d="m16 16 4 4" />
                        </svg>
                        <input type="search" placeholder="Buscar tag..."
                               class="w-full rounded-2xl border border-border bg-background py-2.5 pr-4 pl-10 text-sm text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15" />
                    </label>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-184 border-collapse text-left">
                        <thead
                            class="bg-background-alternative/65 text-xs font-bold uppercase tracking-[0.14em] text-muted-text">
                            <tr>
                                <th class="px-6 py-4">Tag</th>
                                <th class="px-6 py-4">Slug</th>
                                <th class="px-6 py-4 text-center">Reflexões</th>
                                <th class="px-6 py-4">Situação</th>
                                <th class="px-6 py-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @if (TagItems is null)
                            {
                                <tr><td colspan="5" class="px-6 py-8 text-center text-sm text-muted-text">Carregando tags...</td></tr>
                            }
                            else if (TagItems.Count == 0)
                            {
                                <tr><td colspan="5" class="px-6 py-10 text-center text-sm text-muted-text">Nenhuma tag cadastrada ainda.</td></tr>
                            }
                            else
                            {
                                @foreach (var tag in TagItems)
                                {
                                    <DashboardTagRow Id="@tag.Id" Name="@tag.Name" Slug="@tag.Slug"
                                                     PostCount="@tag.PostCount"
                                                     OnDeleteRequested="@RequestDelete" />
                                }
                            }
                                    </tbody>
                                </table>
                            </div>

                            <footer
                                class="flex flex-col justify-between gap-3 border-t border-border px-5 py-4 text-sm text-muted-text sm:flex-row sm:items-center sm:px-6">
                                <span>Exibindo @(TagItems?.Count ?? 0) tags</span>
                                <span>Ordenadas por nome</span>
                            </footer>
                        </section>

                        <aside
                            class="mt-6 flex gap-4 rounded-3xl border border-primary-golden/25 bg-background-alternative p-5 sm:items-center">
                            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-golden/15 text-primary-golden"
                                  aria-hidden="true">!</span>
                            <p class="text-sm leading-6 text-muted-text">
                                <strong class="text-primary-brown">Ao excluir uma tag:</strong>
                                as reflexões associadas serão mantidas; somente a ligação com esse assunto será removida.
                            </p>
                        </aside>
                    </div>

<DashboardDeleteConfirmation IsOpen="@(_tagPendingDeletion is not null)"
                             IsProcessing="@IsDeleting"
                             Title="Excluir tag"
                             Message="@DeleteConfirmationMessage"
                             ConfirmText="Excluir tag"
                             OnConfirm="@ConfirmDeleteAsync"
                             OnCancel="@CancelDelete" />
