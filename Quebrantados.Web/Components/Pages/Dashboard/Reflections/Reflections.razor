@page "/dashboard/reflexoes"
@layout MainLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>
    Reflexões — Quebrantados
</PageTitle>

<div class="mx-auto max-w-360">
    <HeaderDashboard PageName="Gerenciamento do conteúdo" PageTitle="Reflexões"
                     PageDescription="Acompanhe, revise e organize os textos publicados no blog.">
        <LinkDashboard Href="/dashboard/posts/adicionar">
            <SpanDashboard Value="+" />
            Nova reflexão
        </LinkDashboard>
    </HeaderDashboard>

    <section class="grid gap-4 py-8 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumo das reflexões">
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Total de reflexões</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@ReflectionItems.Count</p>
            <p class="mt-3 text-xs text-muted-text">Todo o conteúdo cadastrado</p>
        </article>
        <article class="rounded-3xl border border-border bg-surface p-5">
            <p class="text-sm font-medium text-muted-text">Publicadas</p>
            <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">@ReflectionItems.Count(item =>
                                                item.Status == ReflectionStatus.Published)</p>
                <p class="mt-3 text-xs text-muted-text">Disponíveis para os leitores</p>
            </article>
            <article class="rounded-3xl border border-primary-golden/25 bg-background-alternative p-5">
                <p class="text-sm font-medium text-muted-text">Rascunhos</p>
                <p class="mt-2 font-serif text-4xl font-semibold text-primary-golden">@ReflectionItems.Count(item =>
                                                        item.Status == ReflectionStatus.Draft)</p>
                    <p class="mt-3 text-xs text-muted-text">Aguardando revisão ou conclusão</p>
                </article>
                <article class="rounded-3xl border border-border bg-surface p-5">
                    <p class="text-sm font-medium text-muted-text">Atualizadas recentemente</p>
                    <p class="mt-2 font-serif text-4xl font-semibold text-primary-brown">4</p>
                    <p class="mt-3 text-xs text-muted-text">Alterações nos últimos 7 dias</p>
                </article>
            </section>

            <section class="overflow-hidden rounded-3xl border border-border bg-surface">
                <div class="flex flex-col justify-between gap-4 border-b border-border p-5 lg:flex-row lg:items-center lg:px-6">
                    <div>
                        <h2 class="font-serif text-2xl font-semibold text-primary-brown">Todas as reflexões</h2>
                        <p class="mt-1 text-sm text-muted-text">Visualize e gerencie o conteúdo editorial do blog.</p>
                    </div>

                    <div class="flex w-full flex-col gap-3 sm:flex-row lg:max-w-xl">
                        <label class="relative block flex-1">
                            <span class="sr-only">Buscar reflexão</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                 class="absolute top-1/2 left-4 size-4 -translate-y-1/2 text-muted-text" aria-hidden="true">
                                <circle cx="11" cy="11" r="6" />
                                <path d="m16 16 4 4" />
                            </svg>
                            <input type="search" placeholder="Buscar reflexão..."
                                   class="w-full rounded-2xl border border-border bg-background py-2.5 pr-4 pl-10 text-sm text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15" />
                        </label>
                        <label>
                            <span class="sr-only">Filtrar por situação</span>
                            <select
                                class="w-full rounded-2xl border border-border bg-background px-4 py-2.5 text-sm text-main-text outline-none transition focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15 sm:w-38">
                                <option>Todas</option>
                                <option>Publicadas</option>
                                <option>Rascunhos</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-240 border-collapse text-left">
                        <thead
                            class="bg-background-alternative/65 text-xs font-bold uppercase tracking-[0.14em] text-muted-text">
                            <tr>
                                <th class="px-6 py-4">Reflexão</th>
                                <th class="px-6 py-4">Categoria</th>
                                <th class="px-6 py-4">Situação</th>
                                <th class="px-6 py-4">Última atualização</th>
                                <th class="px-6 py-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            @foreach (var reflection in ReflectionItems)
                            {
                                <tr class="transition hover:bg-background/70">
                                    <td class="max-w-md px-6 py-5">
                                        <strong
                                        class="block truncate font-serif text-lg font-semibold text-primary-brown">@reflection.Title</strong>
                                        <span
                                        class="mt-1 block truncate font-mono text-xs text-muted-text">/reflexoes/@reflection.Slug</span>
                                    </td>
                                    <td class="px-6 py-5">
                                <span
                                    class="inline-flex whitespace-nowrap rounded-full bg-background-alternative px-3 py-1.5 text-xs font-semibold text-secondary-brown">@reflection.Category</span>
                                    </td>
                                    <td class="px-6 py-5">
                                        @if (reflection.Status == ReflectionStatus.Published)
                                        {
                                            <span
                                            class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">Publicada</span>
                                        }
                                        else
                                        {
                                            <span
                                            class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Rascunho</span>
                                        }
                                    </td>
                                    <td class="px-6 py-5 text-sm text-muted-text">@reflection.LastUpdate</td>
                                    <td class="px-6 py-5">
                                        <div class="flex justify-end gap-2">
                                            @if (reflection.Status == ReflectionStatus.Published)
                                            {
                                                <a href="@($"/reflexoes/{reflection.Slug}")" aria-label="Visualizar @reflection.Title"
                                                   class="rounded-xl border border-border px-3 py-2 text-xs font-semibold text-muted-text transition hover:border-primary-golden hover:text-primary-brown">Ver</a>
                                            }
                                            <a href="@($"/dashboard/posts/{reflection.Id}/editar")"
                                               aria-label="Editar @reflection.Title"
                                               class="rounded-xl bg-background-alternative px-3 py-2 text-xs font-semibold text-secondary-brown transition hover:bg-border">Editar</a>
                                            <button type="button" aria-label="Excluir @reflection.Title"
                                                    class="rounded-xl border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50">Excluir</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <footer
                    class="flex flex-col justify-between gap-3 border-t border-border px-5 py-4 text-sm text-muted-text sm:flex-row sm:items-center sm:px-6">
                    <span>Exibindo @ReflectionItems.Count reflexões</span>
                    <span>Ordenadas pela última atualização</span>
                </footer>
            </section>

            <aside
                class="mt-6 flex gap-4 rounded-3xl border border-primary-golden/25 bg-background-alternative p-5 sm:items-center">
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-golden/15 text-primary-golden"
                      aria-hidden="true">✦</span>
                <p class="text-sm leading-6 text-muted-text">
                    <strong class="text-primary-brown">Antes de publicar:</strong>
                    revise o título, o resumo, a categoria e as tags para facilitar a leitura e a descoberta da reflexão.
                </p>
            </aside>
        </div>

@code {
    private static readonly List<ReflectionPreview> ReflectionItems =
    [
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6301"), "O que significa ter um coração quebrantado?",
"o-que-significa-ter-um-coracao-quebrantado", "Estudos bíblicos", ReflectionStatus.Draft, "hoje, às 09:15"),
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6302"), "Quando Deus parece estar em silêncio",
"quando-deus-parece-estar-em-silencio", "Vida cristã", ReflectionStatus.Published, "ontem, às 19:42"),
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6303"), "Graça para recomeçar todos os dias",
"graca-para-recomecar-todos-os-dias", "Evangelho", ReflectionStatus.Published, "há 3 dias"),
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6304"), "A paz que permanece em meio à tempestade",
"a-paz-que-permanece-em-meio-a-tempestade", "Devocionais", ReflectionStatus.Draft, "há 5 dias"),
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6305"), "A sabedoria encontrada na espera",
"a-sabedoria-encontrada-na-espera", "Vida cristã", ReflectionStatus.Published, "há 1 semana"),
        new(Guid.Parse("c30c17f8-8d87-49cd-88d4-9c00ab4a6306"), "O amor que lança fora todo medo",
"o-amor-que-lanca-fora-todo-medo", "Novo Testamento", ReflectionStatus.Published, "há 2 semanas")
    ];

    private enum ReflectionStatus
    {
        Draft,
        Published
    }

    private sealed record ReflectionPreview(
        Guid Id,
        string Title,
        string Slug,
        string Category,
        ReflectionStatus Status,
        string LastUpdate);
}
