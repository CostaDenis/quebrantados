@page "/dashboard"
@layout MainLayout
@inherits DashboardPage

<PageTitle>
    Visão geral — Quebrantados
</PageTitle>

<div class="mx-auto max-w-360">

    <HeaderDashboard PageName="Painel administrativo" PageTitle="Visão geral"
                     PageDescription="Acompanhe o conteúdo do blog e continue de onde parou.">
        <LinkDashboard Href="/dashboard/reflexoes/adicionar">
            <SpanDashboard Value="+" />
            Nova reflexão
        </LinkDashboard>
    </HeaderDashboard>

    <section class="grid gap-4 py-8 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumo do conteúdo">
        @if (DashboardOutput is null)
        {
            @foreach (var _ in Enumerable.Range(0, 4))
            {
                <article class="animate-pulse rounded-3xl border border-border bg-surface p-5 shadow-sm" aria-hidden="true">
                    <div class="h-4 w-24 rounded bg-background-alternative"></div>
                    <div class="mt-3 h-10 w-14 rounded bg-background-alternative"></div>
                    <div class="mt-4 h-3 w-40 rounded bg-background-alternative"></div>
                </article>
            }
        }
        else
        {
            <DashboardMetricCard Label="Reflexões" Value="@DashboardOutput.PostCount" Symbol="§"
                                 Note="@BuildPostNote(DashboardOutput.PublishedPostCount, DashboardOutput.DraftPostCount)" />
            <DashboardMetricCard Label="Categorias" Value="@DashboardOutput.CategoryCount" Symbol="◫"
                                 Note="@BuildCategoryNote(DashboardOutput.EmptyCategoryCount)" />
            <DashboardMetricCard Label="Tags" Value="@DashboardOutput.TagCount" Symbol="#"
                                 Note="@BuildTagNote(DashboardOutput.UnusedTagCount)" />
            <DashboardMetricCard Label="Atualizações" Value="@DashboardOutput.RecentUpdateCount" Symbol="↻"
                                 Note="Alterações nos últimos 7 dias" />
        }
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(19rem,0.7fr)]">
        <section class="overflow-hidden rounded-3xl border border-border bg-surface">
            <div class="flex items-center justify-between gap-4 border-b border-border px-5 py-5 sm:px-6">
                <div>
                    <h2 class="font-serif text-2xl font-semibold text-primary-brown">Reflexões recentes</h2>
                    <p class="mt-1 text-sm text-muted-text">Últimos conteúdos alterados no painel.</p>
                </div>
                <a href="/dashboard/posts"
                   class="shrink-0 text-sm font-semibold text-primary-golden hover:text-secondary-brown">Ver todas
                    →</a>
                </div>

                <div class="divide-y divide-border">
                    @if (DashboardOutput is null)
                    {
                        <p class="px-6 py-8 text-sm text-muted-text">Carregando reflexões...</p>
                    }
                    else if (DashboardOutput.RecentPosts.Count == 0)
                    {
                        <p class="px-6 py-8 text-sm text-muted-text">Nenhuma reflexão foi atualizada nos últimos 7 dias.</p>
                    }
                    else
                    {
                        @foreach (var post in DashboardOutput.RecentPosts)
                        {
                            <DashboardRecentPost Id="@post.Id" Title="@post.Title" Slug="@post.Slug"
                                                 CategoryName="@post.CategoryName" Status="@post.Status"
                                                 LastUpdateDate="@post.LastUpdateDate" />
                        }
                    }
                    </div>
                </section>

                <div class="grid content-start gap-6">
                    <section class="rounded-3xl border border-border bg-surface p-6">
                        <div class="flex items-center justify-between gap-4">
                            <h2 class="font-serif text-2xl font-semibold text-primary-brown">Ações rápidas</h2>
                            <span class="text-primary-golden" aria-hidden="true">✦</span>
                        </div>
                        <div class="mt-5 grid gap-3">
                            <DashboardActionButton Href="/dashboard/posts/novo" Text="Escrever reflexão" />
                            <DashboardActionButton Href="/dashboard/categorias/adicionar" Text="Nova categoria" />
                            <DashboardActionButton Href="/dashboard/tags" Text="Gerenciar tags" />
                        </div>
                    </section>

                    <section class="rounded-3xl border border-border bg-primary-brown p-6 text-surface">
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-secondary-golden">Organização</p>
                        <h2 class="mt-2 font-serif text-2xl font-semibold">Conteúdo por categoria</h2>
                        <div class="mt-6 space-y-4">
                            @if (DashboardOutput is null)
                            {
                                <p class="text-sm text-background-alternative/65">Carregando categorias...</p>
                            }
                            else if (DashboardOutput.CategorySummary.Count == 0)
                            {
                                <p class="text-sm leading-6 text-background-alternative/65">Nenhuma categoria cadastrada ainda.</p>
                            }
                            else
                            {
                                @foreach (var category in DashboardOutput.CategorySummary)
                                {
                                    <DashboardCategorySummary Name="@category.Name" Count="@category.PostCount"
                                                              Percentage="@category.Percentage" />
                                }
                            }
                        </div>
                        <a href="/dashboard/categorias"
                           class="mt-6 inline-flex text-sm font-semibold text-secondary-golden hover:text-surface">Gerenciar
                            categorias →</a>
                        </section>
                    </div>
                </div>

                @if (DashboardOutput is not null && DashboardOutput.DraftPostCount > 0)
                {
                <section
                    class="mt-6 rounded-3xl border border-primary-golden/25 bg-background-alternative p-6 sm:flex sm:items-center sm:justify-between sm:gap-8">
                    <div class="flex gap-4">
                        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-primary-golden/15 text-primary-golden"
                              aria-hidden="true">!</span>
                        <div>
                            <h2 class="font-serif text-xl font-semibold text-primary-brown">@BuildDraftHeading(DashboardOutput.DraftPostCount)</h2>
                            <p class="mt-1 text-sm leading-6 text-muted-text">Revise o conteúdo, complete os dados pendentes e
                                publique quando estiver pronto.</p>
                            </div>
                        </div>
                        <a href="/dashboard/posts?status=rascunho"
                           class="mt-5 inline-flex shrink-0 rounded-full border border-primary-golden/50 px-5 py-2.5 text-sm font-semibold text-primary-brown transition hover:bg-surface sm:mt-0">Revisar
                            rascunhos</a>
                        </section>
                }
                    </div>
