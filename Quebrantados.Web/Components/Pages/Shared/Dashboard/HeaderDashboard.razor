<header class="flex flex-col justify-between gap-6 border-b border-border pb-8 sm:flex-row sm:items-end">
    <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.22em] text-primary-golden">
            @PageName
        </p>
        <h1 class="font-serif text-4xl font-semibold text-primary-brown sm:text-5xl">
            @PageTitle
        </h1>
        <p class="mt-3 max-w-2xl leading-7 text-muted-text">
            @PageDescription
        </p>
    </div>

    @ChildContent

</header>

@code {
    [Parameter, EditorRequired]
    public string PageName { get; set; }

    [Parameter, EditorRequired]
    public string PageTitle { get; set; }

    [Parameter, EditorRequired]
    public string PageDescription { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}