<div>
    <div class="mb-2 flex items-center justify-between gap-4 text-sm">
        <span class="text-background-alternative/80">@Name</span>
        <strong class="text-secondary-golden">@Count</strong>
    </div>
    <div class="h-1.5 overflow-hidden rounded-full bg-surface/10">
        <div class="h-full rounded-full bg-secondary-golden" style="width: @NormalizedPercentage%"></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int Count { get; set; }
    [Parameter, EditorRequired] public int Percentage { get; set; }

    private int NormalizedPercentage => Math.Clamp(Percentage, 0, 100);
}
