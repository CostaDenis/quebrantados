@using Quebrantados.Web.Enums

<tr class="transition hover:bg-background/70">
    <td class="max-w-md px-6 py-5">
        <strong class="block truncate font-serif text-lg font-semibold text-primary-brown">@Title</strong>
        <span class="mt-1 block truncate font-mono text-xs text-muted-text">/reflexoes/@Slug</span>
    </td>
    <td class="px-6 py-5">
        <span
            class="inline-flex whitespace-nowrap rounded-full bg-background-alternative px-3 py-1.5 text-xs font-semibold text-secondary-brown">
            @CategoryName
        </span>
    </td>
    <td class="px-6 py-5">
        @if (Status == EPostStatus.Published)
        {
            <span
            class="whitespace-nowrap rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">Publicada</span>
        }
        else
        {
            <span
            class="whitespace-nowrap rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Rascunho</span>
        }
    </td>
    <td class="whitespace-nowrap px-6 py-5 text-sm text-muted-text">
        @LastUpdateDate.ToString("dd/MM/yyyy 'às' HH:mm")
    </td>
    <td class="px-6 py-5">
        <div class="flex justify-end gap-2">
            @if (Status == EPostStatus.Published)
            {
                <a href="@($"/reflexoes/{Slug}")" aria-label="Visualizar @Title"
                   class="rounded-xl border border-border px-3 py-2 text-xs font-semibold text-muted-text transition hover:border-primary-golden hover:text-primary-brown">
                    Ver
                </a>
            }
            <a href="@($"/dashboard/reflexoes/{Id}/editar")" aria-label="Editar @Title"
               class="rounded-xl bg-background-alternative px-3 py-2 text-xs font-semibold text-secondary-brown transition hover:bg-border">
                Editar
            </a>
            <button type="button" aria-label="Excluir @Title" @onclick="RequestDeleteAsync"
                    class="rounded-xl border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50 cursor-pointer">
                Excluir
            </button>
        </div>
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CategoryName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EPostStatus Status { get; set; }
    [Parameter, EditorRequired] public DateTime LastUpdateDate { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteRequested { get; set; }

    private Task RequestDeleteAsync() => OnDeleteRequested.InvokeAsync(Id);
}
