@if (IsOpen)
{
    <div class="fixed inset-0 z-40 bg-primary-brown/45 backdrop-blur-sm" aria-hidden="true"></div>

    <div class="fixed inset-0 z-50 grid place-items-center p-5" role="dialog" aria-modal="true"
         aria-labelledby="delete-confirmation-title">
        <section class="w-full max-w-md rounded-3xl border border-border bg-surface p-6 shadow-2xl sm:p-7">
            <span class="grid size-11 place-items-center rounded-full bg-red-50 text-lg font-bold text-red-700"
                  aria-hidden="true">!</span>

            <h2 id="delete-confirmation-title" class="mt-5 font-serif text-2xl font-semibold text-primary-brown">
                @Title
            </h2>
            <p class="mt-3 leading-7 text-muted-text">@Message</p>

            <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button type="button" disabled="@IsProcessing" @onclick="CancelAsync"
                        class="rounded-2xl border border-border px-5 py-3 font-semibold text-secondary-brown transition hover:bg-background-alternative disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer">
                    Cancelar
                </button>
                <button type="button" disabled="@IsProcessing" @onclick="ConfirmAsync"
                        class="rounded-2xl bg-red-700 px-5 py-3 font-semibold text-white transition hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer">
                    @(IsProcessing ? "Excluindo..." : ConfirmText)
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar exclusão";
    [Parameter] public string Message { get; set; } = "Esta ação não poderá ser desfeita.";
    [Parameter] public string ConfirmText { get; set; } = "Excluir";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();
    private Task CancelAsync() => OnCancel.InvokeAsync();
}
