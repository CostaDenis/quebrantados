<a href="@Href"
   class="inline-flex items-center justify-center rounded-2xl border border-border bg-surface px-5 py-3 font-semibold text-primary-brown transition hover:border-primary-golden hover:bg-background-alternative">
    @Text
</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;
}
