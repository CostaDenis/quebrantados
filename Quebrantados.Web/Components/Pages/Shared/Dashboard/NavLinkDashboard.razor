<NavLink href="@Href" Match="@Match"
         class="group flex shrink-0 items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-background-alternative/70 transition hover:bg-surface/10 hover:text-surface"
         ActiveClass="bg-surface/12 !text-secondary-golden">
    <span class="shrink-0 transition group-hover:text-secondary-golden">@ChildContent</span>
    <span class="whitespace-nowrap">@Label</span>
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
