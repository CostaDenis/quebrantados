@using Quebrantados.Web.Enums

<article class="group flex flex-col gap-4 px-5 py-5 transition hover:bg-background/70 sm:flex-row sm:items-center sm:px-6">
    <div class="min-w-0 flex-1">
        <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="rounded-full px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wider @StatusClasses">
                @StatusLabel
            </span>
            <span class="text-xs text-muted-text">@CategoryName</span>
        </div>
        <h3 class="truncate font-serif text-xl font-semibold text-primary-brown group-hover:text-secondary-brown">
            @Title
        </h3>
        <p class="mt-1 text-sm text-muted-text">Atualizado em @LastUpdateDate.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
        @if (Status == EPostStatus.Published)
        {
            <a href="@($"/reflexoes/{Slug}")"
               class="rounded-xl border border-border px-3 py-2 text-xs font-semibold text-muted-text transition hover:border-primary-golden hover:text-primary-brown">
                Visualizar
            </a>
        }
        <a href="@($"/dashboard/posts/{Id}/editar")"
           class="rounded-xl bg-background-alternative px-3 py-2 text-xs font-semibold text-secondary-brown transition hover:bg-border">
            Editar
        </a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CategoryName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EPostStatus Status { get; set; }
    [Parameter, EditorRequired] public DateTime LastUpdateDate { get; set; }

    private string StatusLabel => Status == EPostStatus.Published ? "Publicado" : "Rascunho";
    private string StatusClasses => Status == EPostStatus.Published
        ? "bg-green-50 text-green-700"
        : "bg-amber-50 text-amber-700";
}
