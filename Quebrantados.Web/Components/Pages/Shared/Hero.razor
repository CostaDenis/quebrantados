<section id="@Id" class="relative isolate overflow-hidden border-b border-border/70">
    <div
        class="absolute inset-0 -z-10 opacity-60 bg-[radial-gradient(circle_at_20%_15%,#D4B36A24,transparent_30%),radial-gradient(circle_at_84%_75%,#74533D14,transparent_30%)]">
    </div>

    @if (Aside is not null)
    {
        <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-28">
            <div class="max-w-3xl">
                <div class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary-golden">
                    <span class="h-px w-10 bg-primary-golden"></span>
                    @Eyebrow
                </div>
                <h1
                    class="font-serif text-5xl leading-[1.08] font-semibold tracking-tight text-primary-brown sm:text-6xl lg:text-7xl">
                    @Heading
                </h1>
                <p class="mt-7 max-w-2xl text-lg leading-8 text-muted-text">@Description</p>
                @if (Actions is not null)
                {
                    <div class="mt-9 flex flex-wrap gap-4">@Actions</div>
                }
            </div>
            @Aside
        </div>
    }
    else
    {
        <div class="mx-auto max-w-5xl px-5 py-20 text-center lg:px-8 lg:py-28">
            @if (!string.IsNullOrWhiteSpace(IconSrc))
            {
                <div
                    class="mx-auto mb-7 grid size-16 place-items-center rounded-full border border-primary-golden/30 bg-background-alternative">
                    <img src="@IconSrc" alt="" class="size-10" />
                </div>
            }
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.26em] text-primary-golden">@Eyebrow</p>
            <h1 class="font-serif text-5xl leading-tight font-semibold text-primary-brown sm:text-6xl">@Heading</h1>
            <p class="mx-auto mt-7 max-w-3xl text-lg leading-8 text-muted-text">@Description</p>
            @if (Actions is not null)
            {
                <div class="mt-9 flex flex-wrap justify-center gap-4">@Actions</div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Eyebrow { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string? IconSrc { get; set; }
    [Parameter, EditorRequired] public RenderFragment? Heading { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
}
