<aside
    class="border-b border-border bg-primary-brown text-surface lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:border-r lg:border-b-0 lg:border-surface/10">
    <div class="flex items-center justify-between border-b border-surface/10 px-5 py-5 lg:px-6">
        <a href="/dashboard" class="flex items-center gap-3 no-underline">
            <span class="grid size-11 place-items-center rounded-full border border-secondary-golden/40 bg-surface/10">
                <img src="/imgs/icon.svg" alt="" class="size-7 brightness-0 invert" />
            </span>
            <span>
                <strong class="block font-serif text-lg tracking-wide text-surface">Quebrantados</strong>
                <small
                class="block text-[0.62rem] uppercase tracking-[0.2em] text-secondary-golden">Administração</small>
            </span>
        </a>
        <span
        class="rounded-full border border-surface/15 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-background-alternative/70 lg:hidden">Painel</span>
    </div>

    <nav class="flex gap-2 overflow-x-auto px-4 py-4 lg:flex-1 lg:flex-col lg:overflow-visible lg:px-4 lg:py-6"
         aria-label="Navegação administrativa">
        <DashboardNavLink Href="/dashboard" Label="Visão geral" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5"
                 aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
        </DashboardNavLink>
        <DashboardNavLink Href="/dashboard/posts" Label="Reflexões">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5"
                 aria-hidden="true">
                <path d="M5 4h14v16H5z" />
                <path d="M8 8h8M8 12h8M8 16h5" />
            </svg>
        </DashboardNavLink>
        <DashboardNavLink Href="/dashboard/categorias" Label="Categorias">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5"
                 aria-hidden="true">
                <path d="M3 6.5h7l2 2h9v10H3z" />
            </svg>
        </DashboardNavLink>
        <DashboardNavLink Href="/dashboard/tags" Label="Tags">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5"
                 aria-hidden="true">
                <path d="M20 13 11 22l-9-9V4h9l9 9Z" />
                <circle cx="7" cy="9" r="1.5" />
            </svg>
        </DashboardNavLink>

        <div class="mx-3 my-3 hidden h-px bg-surface/10 lg:block"></div>
        <p
            class="hidden px-3 pb-1 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-background-alternative/45 lg:block">
            Conta</p>
            <DashboardNavLink Href="/Account/Manage/ChangePassword" Label="Segurança">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5"
                     aria-hidden="true">
                    <rect x="5" y="10" width="14" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
            </DashboardNavLink>
        </nav>

        <div class="hidden border-t border-surface/10 p-4 lg:block">
            <AuthorizeView Context="authenticationState">
                <Authorized>
                    <div class="mb-3 flex items-center gap-3 rounded-2xl bg-surface/5 p-3">
                        <span
                        class="grid size-9 shrink-0 place-items-center rounded-full bg-secondary-golden font-serif font-bold text-primary-brown">@GetInitial(authenticationState.User.Identity?.Name)</span>
                        <span class="min-w-0">
                            <strong class="block truncate text-sm font-semibold text-surface">Administrador</strong>
                            <small
                            class="block truncate text-xs text-background-alternative/55">@authenticationState.User.Identity?.Name</small>
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="grid grid-cols-2 gap-2">
                <a href="/"
                   class="inline-flex items-center justify-center rounded-xl border border-surface/15 px-3 py-2.5 text-xs font-semibold text-background-alternative transition hover:border-secondary-golden/60 hover:text-secondary-golden">Ver
                    site</a>
                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button type="submit"
                                class="w-full rounded-xl border border-surface/15 px-3 py-2.5 text-xs font-semibold text-background-alternative transition hover:border-red-300/50 hover:text-red-200">Sair</button>
                    </form>
                </div>
            </div>
        </aside>

@code {
    private static string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "A" : name[..1].ToUpperInvariant();
}
