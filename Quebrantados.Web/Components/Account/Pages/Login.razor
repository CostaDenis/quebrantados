@page "/login"
@layout LandingLayout

@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Área administrativa — Quebrantados</PageTitle>

<main class="relative min-h-screen overflow-hidden bg-background text-main-text antialiased">
    <div
        class="absolute inset-0 opacity-60 bg-[radial-gradient(circle_at_12%_15%,#D4B36A2B,transparent_28%),radial-gradient(circle_at_88%_85%,#74533D18,transparent_30%)]">
    </div>

    <div class="relative mx-auto grid min-h-screen max-w-7xl lg:grid-cols-[1fr_0.9fr]">
        <section class="flex flex-col justify-between px-6 py-8 sm:px-10 lg:px-14 lg:py-12">
            <a href="/" class="group flex w-fit items-center gap-3 no-underline">
                <span
                    class="grid size-12 place-items-center rounded-full border border-primary-golden/40 bg-background-alternative transition group-hover:border-primary-golden">
                    <img src="/imgs/icon.svg" alt="" class="size-8" />
                </span>
                <span>
                    <strong class="block font-serif text-xl tracking-wide text-primary-brown">Quebrantados</strong>
                    <small class="block text-[0.65rem] uppercase tracking-[0.22em] text-muted-text">À luz da
                        Palavra</small>
                    </span>
                </a>

                <div class="my-16 max-w-xl lg:my-10">
                    <p
                        class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-primary-golden">
                        <span class="h-px w-10 bg-primary-golden"></span>
                        Área administrativa
                    </p>
                    <h1 class="font-serif text-5xl leading-[1.08] font-semibold text-primary-brown sm:text-6xl">Cuidando de
                        cada palavra publicada.</h1>
                        <p class="mt-7 max-w-lg text-lg leading-8 text-muted-text">Acesse o painel para escrever reflexões,
                            organizar categorias e manter o conteúdo do Quebrantados.</p>
                            <blockquote
                                class="mt-10 border-l-2 border-primary-golden pl-5 font-serif text-xl leading-relaxed text-secondary-brown">
                                “Tudo, porém, seja feito com decência e ordem.”
                                <footer class="mt-3 text-xs font-bold uppercase tracking-[0.18em] text-primary-golden">1 Coríntios
                                    14:40</footer>
                                </blockquote>
                            </div>

                            <p class="text-sm text-muted-text">Quebrantados</p>
                            <p class="text-sm text-muted-text">© @DateTime.Now.Year</p>
                        </section>

                        <section
                            class="flex items-center justify-center border-t border-border bg-surface/85 px-6 py-16 backdrop-blur-sm sm:px-10 lg:border-t-0 lg:border-l lg:px-14">
                            <div class="w-full max-w-md">
                                <div class="mb-9">
                                    <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-primary-golden">Acesso restrito
                                    </p>
                                    <h2 class="font-serif text-4xl font-semibold text-primary-brown">Bem-vindo de volta.</h2>
                                    <p class="mt-3 leading-7 text-muted-text">Informe suas credenciais para acessar o painel.</p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(errorMessage))
                                {
                                    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
                                         role="alert">@errorMessage</div>
                                }

                                <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login"
                                          class="space-y-6">
                                    <DataAnnotationsValidator />
                                    <div>
                                        <label for="Input.Email"
                                               class="mb-2 block text-sm font-semibold text-primary-brown">E-mail</label>
                                        <InputText @bind-Value="Input.Email" id="Input.Email"
                                                   class="w-full rounded-2xl border border-border bg-background px-4 py-3.5 text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15"
                                                   autocomplete="username" aria-required="true" placeholder="seu@email.com" />
                                        <ValidationMessage For="() => Input.Email" class="mt-2 block text-sm text-red-700" />
                                    </div>

                                    <div>
                                        <label for="Input.Password"
                                               class="mb-2 block text-sm font-semibold text-primary-brown">Senha</label>
                                        <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                                                   class="w-full rounded-2xl border border-border bg-background px-4 py-3.5 text-main-text outline-none transition placeholder:text-muted-text/60 focus:border-primary-golden focus:ring-3 focus:ring-primary-golden/15"
                                                   autocomplete="current-password" aria-required="true" placeholder="Digite sua senha" />
                                        <ValidationMessage For="() => Input.Password" class="mt-2 block text-sm text-red-700" />
                                    </div>

                                    <label class="flex w-fit cursor-pointer items-center gap-3 text-sm text-muted-text">
                                        <InputCheckbox @bind-Value="Input.RememberMe"
                                                       class="size-4 rounded border-border accent-primary-brown" />
                                        Manter-me conectado
                                    </label>

                                    <button type="submit"
                                            class="flex w-full items-center justify-center gap-2 rounded-2xl bg-primary-brown px-5 py-3.5 font-semibold text-surface shadow-lg shadow-primary-brown/10 transition hover:-translate-y-0.5 hover:bg-secondary-brown focus:outline-none focus:ring-3 focus:ring-primary-golden/30">
                                        Entrar no painel <span aria-hidden="true">→</span>
                                    </button>
                                </EditForm>

                                <p class="mt-7 text-center text-sm leading-6 text-muted-text">Esta área é exclusiva para a administração
                                    do blog.</p>
                                </div>
                            </section>
                        </div>
                    </main>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new InputModel();
        editContext = new EditContext(Input);
    }

    public async Task LoginUser()
    {
        if (!editContext.Validate())
            return;

        var result = await SignInManager
            .PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo("/dashboard");
        }
        else
        {
            errorMessage = "Usuário ou senha inválidos.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
