@layout HeadlessLayout

<PageTitle>Acesso não autorizado — Quebrantados</PageTitle>

<main
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-background px-5 py-12 text-main-text antialiased">
    <div
        class="absolute inset-0 opacity-60 bg-[radial-gradient(circle_at_15%_15%,#D4B36A2B,transparent_28%),radial-gradient(circle_at_85%_85%,#74533D18,transparent_30%)]">
    </div>

    <section
        class="relative w-full max-w-xl rounded-4xl border border-border bg-surface/90 p-7 text-center shadow-2xl shadow-primary-brown/10 backdrop-blur-sm sm:p-11">
        <a href="/" aria-label="Voltar para o Quebrantados"
           class="mx-auto mb-8 flex w-fit items-center gap-3 no-underline">
            <span
                class="grid size-12 place-items-center rounded-full border border-primary-golden/40 bg-background-alternative">
                <img src="/imgs/icon.svg" alt="" class="size-8" />
            </span>
            <span class="text-left">
                <strong class="block font-serif text-xl tracking-wide text-primary-brown">Quebrantados</strong>
                <small class="block text-[0.65rem] uppercase tracking-[0.22em] text-muted-text">À luz da Palavra</small>
            </span>
        </a>

        <div
            class="mx-auto mb-7 grid size-20 place-items-center rounded-full border border-primary-golden/30 bg-background-alternative text-primary-brown">
            <img src="imgs/padlock.svg" class="size-10" alt="Cadeado">
        </div>

        <p class="mb-3 text-xs font-bold uppercase tracking-[0.24em] text-primary-golden">Acesso restrito</p>
        <h1 class="font-serif text-4xl leading-tight font-semibold text-primary-brown sm:text-5xl">Esta página requer
            autenticação.</h1>
            <p class="mx-auto mt-5 max-w-md text-lg leading-8 text-muted-text">
                Entre com sua conta administrativa para continuar e acessar os recursos de gerenciamento do blog.
            </p>

            <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="/login"
                   class="inline-flex items-center justify-center gap-2 rounded-full bg-primary-brown px-7 py-3.5 font-semibold text-surface shadow-lg shadow-primary-brown/10 transition hover:-translate-y-0.5 hover:bg-secondary-brown">
                    Ir para o login <span aria-hidden="true">→</span>
                </a>
                <a href="/"
                   class="inline-flex items-center justify-center rounded-full border border-border bg-background px-7 py-3.5 font-semibold text-primary-brown transition hover:border-primary-golden">
                    Voltar ao blog
                </a>
            </div>
        </section>
    </main>
